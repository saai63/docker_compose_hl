{
  "$schema": "https://renovatebot.com",
  "extends": [
    "config:recommended"
  ],
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "dependencyDashboard": true,
  "docker-compose": {
    "managerFilePatterns": [
      "/(^|/)docker-compose[^/]*\\.ya?ml$/"
    ]
  },
  "packageRules": [
    {
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "groupName": "Bookstack",
      "matchPackageNames": [
        "lscr.io/linuxserver/bookstack"
      ]
    },
    {
      "groupName": "Homepage",
      "matchPackageNames": [
        "ghcr.io/gethomepage/homepage"
      ]
    },
    {
      "groupName": "Immich Core Suite",
      "matchPackageNames": [
        "ghcr.io/immich-app/**"
      ]
    },
    {
      "groupName": "Jellyfin",
      "matchPackageNames": [
        "jellyfin/jellyfin"
      ]
    },
    {
      "groupName": "Paperless",
      "matchPackageNames": [
        "ghcr.io/paperless-ngx/paperless-ngx"
      ]
    }
]
}
